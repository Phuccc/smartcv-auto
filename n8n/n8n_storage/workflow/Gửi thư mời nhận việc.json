        "jsCode": "// 1. Lấy tên từ node 'Copy file'\nconst tenMoi = $('Copy file').first().json.name;\n\n// 2. Lấy danh sách các item đi vào node này\nconst items = $input.all();\n\n// 3. Chạy vòng lặp để đổi tên cho từng file\nfor (let item of items) {\n  if (item.binary && item.binary.data) {\n    item.binary.data.fileName = `${tenMoi}.pdf`;\n  }\n}\n\nreturn items;\n"
