# Docker Compose Project Name
COMPOSE_PROJECT_NAME=self-hosted_n8n

# Database Configuration (PostgreSQL)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=your_postgres_password
POSTGRES_DB=n8n
POSTGRES_NON_ROOT_USER=postgres
POSTGRES_NON_ROOT_PASSWORD=your_postgres_password

# Redis Configuration
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=your_redis_password

# Qdrant Configuration


# n8n Configuration
# GENERATE A RANDOM KEY FOR THIS! DO NOT SHARE IT.
N8N_ENCRYPTION_KEY=replace_me_with_a_secure_random_string
N8N_USER_MANAGEMENT_DISABLED=false
N8N_EMAIL_MODE=smtp
N8N_SMTP_HOST=smtp.gmail.com
N8N_SMTP_PORT=465
N8N_SMTP_USER=your_email@gmail.com
N8N_SMTP_PASS=your_app_password
N8N_SMTP_SENDER=your_email@gmail.com
N8N_SMTP_SSL=true
GENERIC_TIMEZONE=Asia/Ho_Chi_Minh

# n8n Queue Mode Specifics
EXECUTIONS_MODE=queue
WORKER_COUNT=4
WORKER_CPU_LIMIT=0.5
WORKER_RAM_LIMIT=1024M
QUEUE_BULL_REDIS_HOST=redis
QUEUE_BULL_REDIS_PORT=6379
QUEUE_BULL_REDIS_PASSWORD=your_redis_password
DB_TYPE=postgresdb
DB_POSTGRESDB_HOST=postgres
DB_POSTGRESDB_PORT=5432
DB_POSTGRESDB_DATABASE=n8n
DB_POSTGRESDB_USER=postgres
DB_POSTGRESDB_PASSWORD=your_postgres_password

# Webhook URL (Important for public access)
WEBHOOK_URL=https://n8n.yourdomain.com

# Cloudflare Tunnel Token
# Get this from Cloudflare Zero Trust Dashboard
TUNNEL_TOKEN=your_tunnel_token_here
